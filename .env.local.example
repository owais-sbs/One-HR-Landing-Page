# Copy to .env.local and fill in real values. Never commit secrets.

# Gmail SMTP (used by /api/contact)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="One HR Contact <your.address@gmail.com>"

# Optional aliases supported by API route (use either SMTP_* or EMAIL_*)
EMAIL_USER=your.address@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="One HR Contact <your.address@gmail.com>"
